# Data
data/
*.sqlite3

# Evals: downloaded datasets and resume caches (results/ itself is committed;
# each cell folder evals/results/<cell>/ carries its own .cache/)
evals/datasets/
evals/results/**/.cache/
evals_memory_arena/datasets/
evals_memory_arena/results/**/.cache/

# Supervisor attempt logs (scratch; results/ carries the real outputs)
evals/results/.supervisor/

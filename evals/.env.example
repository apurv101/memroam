# Eval backend profiles — copy to evals/.env (gitignored) and fill in.
# run.mjs and drivers/smoke.mjs load this automatically; real environment
# variables always win over values here.
#
# Naming convention per provider tag (what you pass as --provider):
#   <PROVIDER>_ANTHROPIC_BASE_URL   used by the claude harness
#   <PROVIDER>_OPENAI_BASE_URL      used by the codex harness
#   <PROVIDER>_API_KEY              the key; its NAME is what the drivers pass around
# With a profile filled in, a cell needs only:
#   node evals/run.mjs --suite micro --baselines --harness claude \
#     --provider dashscope --model qwen3-30b-a3b --bare
# Validate a new backend first:
#   node evals/drivers/smoke.mjs --harness claude,codex --provider dashscope --model qwen3-30b-a3b

# ── DashScope / Alibaba Model Studio (international, Singapore region) ────────
# Console: https://bailian.console.alibabacloud.com  (alibabacloud.com — NOT aliyun.com)
# Workspace-scoped endpoints look like https://ws-<id>.<region>.maas.aliyuncs.com/...
DASHSCOPE_ANTHROPIC_BASE_URL=https://dashscope-intl.aliyuncs.com/api/v2/apps/claude-code-proxy
# Codex side goes through a local LiteLLM shim — DashScope's native /responses
# endpoint drops ~50% of multi-round tool calls with codex's tool dialect;
# the shim bridges to chat-completions. Start before codex+dashscope runs:
#   litellm --config evals/litellm.dashscope.yaml --port 4041
DASHSCOPE_OPENAI_BASE_URL=http://127.0.0.1:4041/v1
DASHSCOPE_UPSTREAM_OPENAI_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=sk-...

# ── Vast.ai (self-hosted vLLM pod, managed by `node evals/vast.mjs`) ──────────
# Both harnesses go through one local LiteLLM shim (port 4042): claude hits its
# Anthropic /v1/messages, codex its /v1/responses→chat bridge. The pod's real
# endpoint + per-pod vLLM key (VAST_API_KEY) are GENERATED into evals/.vast.env
# by `vast.mjs up` — don't put them here.
#   Manual flow: vast.mjs search → start --offer <id> → status → probe →
#   run.mjs cells with --provider vast → vast.mjs down (see evals/vast.mjs header)
VAST_ANTHROPIC_BASE_URL=http://127.0.0.1:4042
VAST_OPENAI_BASE_URL=http://127.0.0.1:4042/v1
# Your Vast.ai ACCOUNT key (cloud.vast.ai → Account → API Key) — REST auth for
# provisioning only; never sent to the model backend:
VAST_ACCOUNT_API_KEY=

# ── DeepSeek (first-party, Anthropic-compatible path) ─────────────────────────
#DEEPSEEK_ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
#DEEPSEEK_OPENAI_BASE_URL=https://api.deepseek.com/v1
#DEEPSEEK_API_KEY=sk-...
